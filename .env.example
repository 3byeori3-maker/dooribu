OPENAI_API_KEY=your_api_key_here

# Doori 전용 Supabase 프로젝트의 Connect 화면에서 가져옵니다.
# 기존 Verywell 프로젝트의 URL/키를 절대 사용하지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-doori-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_doori_key

# 배포 전 계정 경계 검사에 사용합니다. 비밀값은 아닙니다.
DOORI_ACCOUNT_EMAIL=3byeori3@gmail.com
DOORI_SUPABASE_PROJECT_REF=your-doori-project-ref
DOORI_VERCEL_ORG_ID=your-doori-vercel-org-id
DOORI_VERCEL_PROJECT_ID=your-doori-vercel-project-id
DOORI_GITHUB_REPOSITORY=your-github-user/doori-math-tutor
